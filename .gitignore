__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Cached API responses. Regenerate with `chemdisco fetch`; never commit a large
# cache, but DO commit small fixtures under tests/fixtures/ when a test needs them.
.cache/
cache/
*.json.gz
!tests/fixtures/**/*.json.gz

# Trained models.
*.joblib

# Run outputs. The logs and JSON under runs/ ARE the record on a local machine --
# where an Actions run had an immutable run id attached to the commit, here the
# terminal is the only witness -- so they are committed deliberately. Poses and
# other bulk artefacts are not.
runs/**/*.pdbqt
runs/**/*.sdf

# Driver logs are the detached-launch wrapper's stdout and duplicate the tee'd
# log beside them. The tee'd log is the record; this is the plumbing.
runs/*_driver.log
runs/*_queue.status
runs/enrichment.console.log
